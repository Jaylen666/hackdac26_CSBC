    {
      "id": "A2",
      "type": "producer_contract",
      "claim": "The hardware/firmware must assert reg2hw.fifo_ctrl.rxrst.qe and .txrst.qe concurrently with the corresponding .q bit to assert uart_fifo_rxrst or uart_fifo_txrst",
      "cond": "whenever a FIFO reset is intended",
      "risk": "If qe is not set, the reset signal remains de-asserted, leaving the FIFO in an uncleared state, potentially exposing old sensitive data",
      "signals": [
        "reg2hw.fifo_ctrl.rxrst.q",
        "reg2hw.fifo_ctrl.rxrst.qe",
        "reg2hw.fifo_ctrl.txrst.q",
        "reg2hw.fifo_ctrl.txrst.qe",
        "uart_fifo_rxrst",
        "uart_fifo_txrst"
      ],
      "refs": [
        "file:81-82"
      ]
    }

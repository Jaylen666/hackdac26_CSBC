  "assumptions": [
    {
      "id": "A1",
      "type": "producer_contract",
      "claim": "The external address decoder must drive dev_select_t as a one-hot vector (or otherwise ensure that at most one select line is active), so that the inequality dev_select_t >= NWD'(N) selects exactly one socket per cycle.",
      "cond": "every cycle where a request could be routed",
      "risk": "If multiple sockets are simultaneously selected, multiple error responses can be driven on the shared bus, causing contention and possibly data corruption.",

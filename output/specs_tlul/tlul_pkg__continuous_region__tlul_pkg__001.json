  "assumptions": [
    {
      "id": "A1",
      "type": "value_domain",
      "claim": "The top-level address user width (TL_AUW) must be at least the sum of mubi, H2D command integrity, and data integrity widths so that RsvdWidth remains non-negative.",
      "cond": "always (compile-time requirement)",
      "risk": "If TL_AUW is insufficient, RsvdWidth underflows and becomes a large positive number via unsigned wrap, corrupting bus field partitioning.",
      "signals": [
        "RsvdWidth"
      ],
      "refs": [
        "tlul_pkg.sv:36-37"
      ],
      "formal": {
        "temporal_shape": "always",
        "antecedent": "",
